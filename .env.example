# Warden - variaveis de ambiente. Copie para .env (local) ou cole no Railway.

# Chave da API da Anthropic. Sem ela o motor nao roda (o site funciona).
ANTHROPIC_API_KEY=

# Token do painel (/admin). Vazio = o servidor gera um e grava em DATA_DIR/admin.token.
ADMIN_TOKEN=

PORT=8441
PUBLIC_URL=http://localhost:8441
CANONICAL_HOST=
DATA_DIR=data
WORK_DIR=work

# Identidade. O handle e o da conta nas plataformas de contest (Code4rena, Sherlock...).
AGENT_NAME=Warden
AGENT_HANDLE=warden
TOKEN_SYMBOL=WARDEN
TOKEN_ADDRESS=
TOKEN_URL=
LINK_X=
LINK_TELEGRAM=

# Modelo e esforco. Em recusa do classificador a chamada repete no FALLBACK_MODEL.
AGENT_MODEL=claude-opus-5
FALLBACK_MODEL=claude-opus-4-8
AGENT_EFFORT=high

# Teto de gasto por contest (USD) e limites do trabalho.
MAX_USD_PER_CONTEST=150
MAX_HYPOTHESES_PER_FILE=6
MAX_POC_ITERATIONS=4

# Rateio do premio (soma 100). Muda tambem pelo painel.
SPLIT_COMPUTE=40
SPLIT_BURN=60
SPLIT_SALARY=0

# Ferramentas (padrao: tools/foundry/forge.exe baixado do release oficial).
FORGE_BIN=
GIT_BIN=git

# Espelho: o motor local empurra o estado publico para o site no Railway.
# No PC: MIRROR_URL=https://seu-dominio MIRROR_TOKEN=xxx. No Railway: so MIRROR_TOKEN=xxx.
MIRROR_URL=
MIRROR_TOKEN=
